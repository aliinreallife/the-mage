{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "prebuild": "node scripts/make-icons.mjs",
    "pretest": "node scripts/binaries.mjs restore && node scripts/make-icons.mjs",
    "verify": "node scripts/binaries.mjs restore && node scripts/make-icons.mjs && node scripts/check-jsonl.mjs docs/balance && vitest run && vite build && node scripts/verify-build.mjs",
    "check:jsonl": "node scripts/check-jsonl.mjs docs/balance",
    "package": "node scripts/package.mjs",
    "staging:https": "node scripts/staging-https.mjs",
    "qa:screenshots": "npm run build && node scripts/browser-smoke.mjs && node scripts/browser-smoke.mjs --staging && node scripts/copy-shots.mjs",
    "binaries:restore": "node scripts/binaries.mjs restore",
    "binaries:embed": "node scripts/binaries.mjs embed",
    "verify:delivery": "node scripts/verify-delivery.mjs",
    "release": "npm run package && npm run verify:delivery"
  },
  "dependencies": {
    "@fontsource/lalezar": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "playwright": "^1.56.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
